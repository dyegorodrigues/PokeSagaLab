# Required only for AI planning and image generation.
# Configure this as a secret in Google AI Studio, Cloud Run, Vercel or the chosen host.
GEMINI_API_KEY=

# Stable defaults documented by Google AI in July 2026.
# Override only when intentionally testing another compatible model.
GEMINI_PLANNER_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_LITE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_LEGACY_MODEL=gemini-2.5-flash-image

# Express server port. Most managed platforms inject PORT automatically.
PORT=3000

# Optional public application URL for future callbacks and absolute links.
APP_URL=
